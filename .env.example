# The Roots Corner — environment
#
# Nothing here has a default. Every value is a real detail belonging to the
# house, and the site is built so that an unset value switches a feature OFF
# rather than falling back to something plausible-looking (CLAUDE.md §5). A
# wrong phone number or a dead address is the one kind of invented information
# a visitor acts on without checking.

# --- Channels shown on the contact page -----------------------------------
# WhatsApp. The house's own number is SOURCED and lives in lib/site.ts, so this
# does not need to be set — leave it out and the published number is used.
# Set it to change the number (international form, spaced however it should
# read — that string is what a visitor sees; the wa.me link strips it back to
# digits itself), or to an EMPTY string to switch the channel off entirely.
# NEXT_PUBLIC_WHATSAPP="+32 495 72 11 28"

# The address SHOWN on the page, for someone who would rather write from their
# own mail client. Not where the form delivers — that is ENQUIRY_TO below, so
# the delivery address never has to be published to publish a form.
NEXT_PUBLIC_CONTACT_EMAIL="bonjour@therootscorner.com"

# Other social accounts. Unset ones do not render.
NEXT_PUBLIC_FACEBOOK=
NEXT_PUBLIC_PINTEREST=
NEXT_PUBLIC_TIKTOK=

# --- The enquiry form -----------------------------------------------------
# The form renders whether or not these are set. Unset, /api/enquiry answers
# 503, the form reports the failure honestly, keeps what the visitor typed and
# hands it to WhatsApp with the message already written. Nothing ever says
# "sent" unless Resend actually accepted it.
#
# ENQUIRY_FROM must be on a domain verified in the Resend dashboard — Resend
# rejects anything else.
RESEND_API_KEY=
ENQUIRY_FROM="The Roots Corner <site@therootscorner.com>"
ENQUIRY_TO=          # optional; defaults to NEXT_PUBLIC_CONTACT_EMAIL

# A test seam only, for scripts/test-enquiry.mjs to point the route at a local
# stub. NEVER set this in production.
RESEND_ENDPOINT=

# --- Shopify: the shop's backend ------------------------------------------
# Unset, every buy action stays the enquiry it has always been and /checkout
# says so BEFORE the button is pressed. There is no half-on state to worry
# about: paymentReady() needs the credentials AND at least one piece linked.
#
# The token here is the STOREFRONT token — Shopify admin → Settings → Apps and
# sales channels → Develop apps → Storefront API. It is designed to ship to a
# browser: it can read published products and create a cart, and nothing else.
#
# ⚠️ NEVER give the Admin token a NEXT_PUBLIC_ prefix. That prefix inlines a
# value into every bundle the site serves, and the Admin token can read
# customers and orders and edit the store. See SHOPIFY_ADMIN_TOKEN below, which
# is server-only on purpose.
NEXT_PUBLIC_SHOPIFY_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
#
# Then link the catalogue to the store — a cart line references a Shopify
# variant ID and nothing else, so the 38 pieces have to exist there first:
#
#   node scripts/shopify-link.mjs           # dry run: what would be linked
#   node scripts/shopify-link.mjs --write   # writes docs/shopify.json
#
# ⚠️ Turning payment on is TWO jobs. Shopify's hosted checkout sets third-party
# cookies, so `cookies` in lib/legal.ts — which currently states this site sets
# none — becomes wrong in the permissive direction, and the consent banner has
# to arm (CLAUDE.md §44). Do both in the same change.

# --- Newsletter -----------------------------------------------------------
# Until these are set, addresses are written to a local file, which is NOT
# durable on a serverless host.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=

# --- Cookie consent -----------------------------------------------------------
# The banner is DORMANT until one of these is set, and that is deliberate: the
# site currently sets no cookies and its Cookie Policy says so in as many words.
# See lib/consent.ts.
#
# ⚠️ Setting either of these means lib/legal.ts's `cookies` document becomes
# WRONG — it states there are none. Rewrite it in the same change.
#
# Google Analytics measurement id. Turning this on makes the banner appear.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
#
# Any cross-site advertising pixel. Nothing uses this yet.
# NEXT_PUBLIC_MARKETING_PIXEL=
